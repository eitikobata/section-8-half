# ============================================================================
# PRODUCTION ENVIRONMENT — section-8-half
# ============================================================================
# Copy to .env.production and fill in real values. NEVER commit this file.
#
# Critical: FRONTEND_URL must match the frontend's real origin exactly, and
# COOKIE_SECURE=true only works over HTTPS.

FRONTEND_URL=https://yourdomain.com
NODE_ENV=production

# Database -- shared Postgres instance already running on the VPS,
# NOT a container in docker-compose.easypanel.yml. DB_NAME must be a
# database that already exists there (create once with
# `CREATE DATABASE section8half;`). See docs/bloco6-deploy.md for how
# to reach it and create the database.
SHARED_POSTGRES_PASSWORD=REPLACE_WITH_ACTUAL_PASSWORD
DB_NAME=section8half

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_IF_NEEDED

# Auth — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_HEX_32
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_HEX_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_DOMAIN=.yourdomain.com

# Demo account — consider rotating/disabling in production
DEMO_USER_USERNAME=analyst-demo
DEMO_USER_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# AI integration
AI_PROVIDER=gemini
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=REPLACE_WITH_ACTUAL_KEY
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=30000
AI_DEBUG=false

# Correlation engine (defaults usually fine for prod too)
CORRELATION_WINDOW_MS=60000
CORRELATION_EVENT_THRESHOLD=3
CORRELATION_SEVERITY_THRESHOLD=50
CORRELATION_CONSUMER_GROUP=correlation-engine
CORRELATION_CONSUMER_NAME=
CORRELATION_BLOCK_MS=5000
CORRELATION_BATCH_COUNT=10

# Ports
PORT=3000
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_WS_URL=wss://yourdomain.com
NEXT_PUBLIC_INCIDENT_DECISION_TIMEOUT_MS=120000
