# ============================================================================
# PRODUCTION ENVIRONMENT — section-8-half
# ============================================================================
# Copy to .env.production and fill in actual production values.
# THIS FILE SHOULD NEVER BE COMMITTED TO GIT.
#
# Critical: auth hardening in production requires exact FRONTEND_URL/BACKEND_URL
# matching and COOKIE_SECURE=true (only works with HTTPS).

# ============================================================================
# DEPLOYMENT
# ============================================================================
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
NODE_ENV=production

# ============================================================================
# SECURITY SECRETS
# ============================================================================
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_HEX_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_HEX_32_CHARS

# ============================================================================
# DATABASE
# ============================================================================
# Use managed PostgreSQL service or Docker secrets in production
DATABASE_URL=postgresql://postgres:SECURE_PASSWORD@postgres-host:5432/section8half

# ============================================================================
# REDIS
# ============================================================================
# Use managed Redis service or Docker secrets
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=SECURE_PASSWORD_IF_NEEDED

# ============================================================================
# AUTH & COOKIES
# ============================================================================
COOKIE_SECURE=true
COOKIE_DOMAIN=.yourdomain.com

# Demo credentials: consider rotating or disabling in production
DEMO_USER_USERNAME=analyst-demo
DEMO_USER_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# ============================================================================
# AI INTEGRATION
# ============================================================================
AI_PROVIDER=claude
CLAUDE_API_KEY=sk-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================================================
# RATE LIMITING
# ============================================================================
# Suggested for production: tighter limits
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=warn
AI_DEBUG=false

# ============================================================================
# PORTS (usually behind reverse proxy in production)
# ============================================================================
PORT=3000

# Frontend will be served by Next.js or reverse proxy (e.g., nginx)
# Backend API port (usually not exposed directly)
