# ============================================================================
# Build stage
# ============================================================================
FROM node:20-alpine AS builder

RUN apk add --no-cache openssl

WORKDIR /app/backend

# Install deps first (better layer caching)
COPY backend/package*.json ./
RUN npm ci

# Copy source and build
COPY backend/tsconfig.json backend/nest-cli.json ./
COPY backend/src ./src
COPY backend/prisma ./prisma

# Generate Prisma client, then compile TypeScript
RUN npx prisma generate
RUN npm run build

# ============================================================================
# Runtime stage
# ============================================================================
FROM node:20-alpine

WORKDIR /app/backend

ENV NODE_ENV=production

RUN apk add --no-cache dumb-init openssl

# Install production deps only
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Copy built output + Prisma schema (needed at runtime for migrations/client)
COPY --from=builder /app/backend/dist ./dist
COPY --from=builder /app/backend/prisma ./prisma
COPY --from=builder /app/backend/node_modules/.prisma ./node_modules/.prisma

# seed.ts imports from ../src/config directly and runs via ts-node
# (not compiled), so the TS source + tsconfig need to be present too.
COPY --from=builder /app/backend/src ./src
COPY --from=builder /app/backend/tsconfig.json ./

# Healthcheck must wait for the response and exit explicitly. The
# previous version fired an async http.get and let the process exit
# before the callback ran, so it never actually verified anything and
# an unhandled socket error could fail it outright -- which left the
# Swarm task stuck in "Starting" forever, endlessly replacing the
# container with no error reported.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "const r=require('http').get('http://127.0.0.1:3000/',res=>{process.exit(res.statusCode<500?0:1)});r.on('error',()=>process.exit(1));r.setTimeout(4000,()=>process.exit(1));"

EXPOSE 3000

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
