# ============================================================================
# Build stage
# ============================================================================
FROM node:20-alpine AS builder

WORKDIR /app/frontend

# Install deps first (better layer caching)
COPY frontend/package*.json ./
RUN npm ci

# Copy source and build
COPY frontend/tsconfig.json frontend/tailwind.config.ts frontend/postcss.config.js frontend/next.config.js ./
COPY frontend/src ./src
COPY frontend/public ./public

RUN npm run build

# ============================================================================
# Runtime stage
# ============================================================================
FROM node:20-alpine

WORKDIR /app/frontend

ENV NODE_ENV=production

RUN apk add --no-cache dumb-init

# Install production deps only
COPY frontend/package*.json ./
RUN npm ci --omit=dev

# Copy built output
COPY --from=builder /app/frontend/.next ./.next
COPY --from=builder /app/frontend/public ./public
COPY --from=builder /app/frontend/next.config.js ./

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001', (r) => {if (r.statusCode >= 500) throw new Error(r.statusCode)})"

EXPOSE 3001

ENTRYPOINT ["dumb-init", "--"]
CMD ["npx", "next", "start", "-p", "3001"]
