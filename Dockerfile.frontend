# ============================================================================
# Build stage
# ============================================================================
FROM node:20-alpine AS builder

WORKDIR /app/frontend

# Install deps first (better layer caching)
COPY frontend/package*.json ./
RUN npm ci

# Copy source and build
COPY frontend/tsconfig.json frontend/tailwind.config.ts frontend/postcss.config.js frontend/next.config.js ./
COPY frontend/src ./src
COPY frontend/public ./public

# NEXT_PUBLIC_* vars get inlined into the JS bundle at build time by
# `next build` -- setting them as a runtime environment.
# variable on the container does nothing after the fact, the value is
# already baked into the static chunks. They must be passed as Docker
# build args (--build-arg or the platform's "Build Arguments" field,
# NOT just "Environment Variables") and promoted to ENV here so
# process.env.NEXT_PUBLIC_* is actually set while `next build` runs.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_INCIDENT_DECISION_TIMEOUT_MS=120000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_INCIDENT_DECISION_TIMEOUT_MS=$NEXT_PUBLIC_INCIDENT_DECISION_TIMEOUT_MS

RUN npm run build

# ============================================================================
# Runtime stage
# ============================================================================
FROM node:20-alpine

WORKDIR /app/frontend

ENV NODE_ENV=production

RUN apk add --no-cache dumb-init

# Install production deps only
COPY frontend/package*.json ./
RUN npm ci --omit=dev

# Copy built output
COPY --from=builder /app/frontend/.next ./.next
COPY --from=builder /app/frontend/public ./public
COPY --from=builder /app/frontend/next.config.js ./

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "const r=require('http').get('http://127.0.0.1:3001/',res=>{process.exit(res.statusCode<500?0:1)});r.on('error',()=>process.exit(1));r.setTimeout(4000,()=>process.exit(1));"

EXPOSE 3001

ENTRYPOINT ["dumb-init", "--"]
CMD ["npx", "next", "start", "-p", "3001"]
