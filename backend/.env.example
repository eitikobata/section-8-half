NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_INCIDENT_DECISION_TIMEOUT_MS=120000

# Auth hardening note: the backend's FRONTEND_URL env var must match
# the origin this app actually runs on (protocol + host + port), or
# the httpOnly refresh cookie won't be accepted cross-origin. If you
# run this on http://localhost:3001, backend's FRONTEND_URL must say
# exactly that.
