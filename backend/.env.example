# ============================================================================
# Backend environment — section-8-half
# ============================================================================

# App
PORT=3000
FRONTEND_URL=http://localhost:3001

# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/section8half

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_KEY=events:stream

# Correlation engine
CORRELATION_WINDOW_MS=60000
CORRELATION_EVENT_THRESHOLD=3
CORRELATION_SEVERITY_THRESHOLD=50
CORRELATION_CONSUMER_GROUP=correlation-engine
CORRELATION_CONSUMER_NAME=
CORRELATION_BLOCK_MS=5000
CORRELATION_BATCH_COUNT=10

# Auth (JWT)
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Demo user (seeded by prisma/seed.ts)
DEMO_USER_USERNAME=analyst-demo
DEMO_USER_PASSWORD=demo12345

# AI integration
AI_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=30000
AI_DEBUG=false

# ----------------------------------------------------------------------
# Note: FRONTEND_URL here must match the frontend's actual origin
# (protocol + host + port) exactly, or the httpOnly refresh cookie
# won't be accepted cross-origin. In prod, COOKIE_SECURE must be true
# and both apps must run on HTTPS.
# ----------------------------------------------------------------------
