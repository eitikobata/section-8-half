# Section 8½ — environment variables

# App
PORT=3000

# Database (Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/section8half?schema=public"

# Redis (Streams)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_KEY=events:stream

# Simulator (Bloco 1) — target the local webhook
SIMULATOR_TARGET_URL=http://localhost:3000/events
SIMULATOR_INTERVAL_MS=3000

# Correlation engine (Bloco 2)
CORRELATION_WINDOW_MS=60000
CORRELATION_EVENT_THRESHOLD=3
CORRELATION_SEVERITY_THRESHOLD=50
CORRELATION_CONSUMER_GROUP=correlation-engine
CORRELATION_CONSUMER_NAME=
CORRELATION_BLOCK_MS=5000
CORRELATION_BATCH_COUNT=10

# Auth (Bloco 4.5)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Demo user (seeded via `npm run prisma:seed`)
DEMO_USER_USERNAME=analyst-demo
DEMO_USER_PASSWORD=demo12345
