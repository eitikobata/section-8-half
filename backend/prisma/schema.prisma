// Section 8½ — Threat Correlation Engine
// Prisma schema — Bloco 1 (Ingestion layer) + Bloco 4 (IA integration)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A monitored entity in the system (an android, a cyberbrain, a terminal, etc).
// Not necessarily created explicitly — it gets upserted the first time
// an event references it.
model Entity {
  id        String   @id @default(cuid())
  externalId String  @unique // the entity_id sent by sensors
  label     String?          // human-friendly name, optional
  type      String?          // e.g. "android", "cyberbrain", "terminal"
  location  String?          // last known location
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events     RawEvent[]
  incidents  Incident[]

  @@map("entities")
}

// Raw event as received from a sensor, before/after correlation.
// This is the audit log — every event that hits the webhook lands here,
// regardless of whether it ends up triggering an incident.
model RawEvent {
  id           String   @id @default(cuid())
  entity       Entity   @relation(fields: [entityId], references: [id])
  entityId     String

  eventType    String   // e.g. "login_failure", "location_change", "privileged_access_attempt"
  location     String?
  severityRaw  Int      // 0-100, as reported by the sensor, unvalidated/uncorrelated
  occurredAt   DateTime // timestamp reported by the sensor
  receivedAt   DateTime @default(now()) // timestamp we actually received it

  metadata     Json?    // free-form payload for anything sensor-specific

  incidentId   String?
  incident     Incident? @relation(fields: [incidentId], references: [id])

  @@index([entityId, occurredAt])
  @@map("raw_events")
}

// An incident is what the correlation engine opens once a pattern
// of raw events for the same entity crosses a threshold within a
// sliding time window. This model gets fleshed out more in Bloco 2,
// but the base fields live here so the FK from RawEvent works from day 1.
model Incident {
  id           String   @id @default(cuid())
  entity       Entity   @relation(fields: [entityId], references: [id])
  entityId     String

  status       IncidentStatus @default(NEW)
  severity     Int?           // calculated severity (Bloco 2), not the raw one
  summary      String?        // AI-generated summary (Bloco 4)
  suggestedSeverity Int?      // AI re-evaluated severity (Bloco 4)
  aiAgentSuggestion Json?     // {agentId, agentName, specialty, protocol, rulesOfEngagement} (Bloco 4)
  analystDecision Json?       // {action, agentFinal, protocolFinal, rulesFinal, timestamp} (Bloco 4)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  closedAt     DateTime?

  events       RawEvent[]
  comments     IncidentComment[]

  @@index([entityId, status])
  @@map("incidents")
}

// Analyst comment on an incident. `author` used to be free text before
// Bloco 4.5 — now it's a FK to the authenticated user who posted it.
model IncidentComment {
  id         String   @id @default(cuid())
  incident   Incident @relation(fields: [incidentId], references: [id])
  incidentId String

  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  @@index([incidentId])
  @@map("incident_comments")
}

// Status flow: NEW (just correlated) -> TRIAGED (AI has analyzed and
// suggested a response) -> RESPONSE_DEPLOYED (analyst registered a
// decision) -> CLOSED. ESCALATED is a manual branch reachable from any
// non-terminal state, for when an incident needs to jump the queue.
enum IncidentStatus {
  NEW
  TRIAGED
  RESPONSE_DEPLOYED
  ESCALATED
  CLOSED
}

// Analyst account (Bloco 4.5 — Auth MVP).
// Single role for now: ANALYST. A real role hierarchy
// (Operator/Supervisor/Commander) only gets introduced once an actual
// product flow needs to tell analysts apart — not before.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(ANALYST)
  createdAt    DateTime @default(now())

  refreshTokens    RefreshToken[]
  incidentComments IncidentComment[]

  @@map("users")
}

enum UserRole {
  ANALYST
}

// Refresh tokens are stored hashed (SHA-256) — never the raw token.
// revokedAt is the whole revocation mechanism: no separate Redis
// blacklist, this table already gives us a fast unique lookup by hash
// plus an audit trail of every token ever issued.
model RefreshToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String

  tokenHash  String    @unique
  jti        String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
