# ============================================================================
# ENVIRONMENT CONFIGURATION — section-8-half (dev)
# ============================================================================
# Copy to .env for docker-compose. Defaults below work out of the box
# for local development.

# ============================================================================
# SHARED
# ============================================================================
# Must match the actual frontend origin exactly, or the httpOnly refresh
# cookie won't be accepted cross-origin.
FRONTEND_URL=http://localhost:3001

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=section8half
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/section8half

# ============================================================================
# REDIS
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_KEY=events:stream

# ============================================================================
# AUTH (JWT)
# ============================================================================
# Generate strong secrets in production: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Demo account (seeded by prisma/seed.ts, used by frontend auto-fill button)
DEMO_USER_USERNAME=analyst-demo
DEMO_USER_PASSWORD=demo12345

# ============================================================================
# AI INTEGRATION
# ============================================================================
AI_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=30000
AI_DEBUG=false

# ============================================================================
# CORRELATION ENGINE
# ============================================================================
CORRELATION_WINDOW_MS=60000
CORRELATION_EVENT_THRESHOLD=3
CORRELATION_SEVERITY_THRESHOLD=50
CORRELATION_CONSUMER_GROUP=correlation-engine
CORRELATION_CONSUMER_NAME=
CORRELATION_BLOCK_MS=5000
CORRELATION_BATCH_COUNT=10

# ============================================================================
# PORTS & FRONTEND-FACING VARS
# ============================================================================
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_INCIDENT_DECISION_TIMEOUT_MS=120000

# Note: auth rate limiting (5 login attempts/min) is hardcoded via
# @Throttle in auth.controller.ts, not env-configurable.
