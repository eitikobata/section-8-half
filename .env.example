# ============================================================================
# ENVIRONMENT CONFIGURATION — section-8-half
# ============================================================================
# Copy this to .env (dev) or .env.production (prod) and fill in actual values.
# For Docker Compose, environment variables can be sourced from this file
# or passed directly in docker-compose.yml.

# ============================================================================
# SHARED (Backend + Frontend + Infrastructure)
# ============================================================================

# Domain and protocol for the deployment
# Dev: use http://localhost:3000 (or whatever port)
# Prod: must be https://yourdomain.com (no trailing slash)
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/section8half

# Optional: for local development, might differ from docker environment
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=section8half

# ============================================================================
# CACHE & STREAMS (Redis)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_KEY=events:stream

# ============================================================================
# AUTH (JWT)
# ============================================================================
# Generate strong secrets in production: `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Cookie settings
# In production with HTTPS: set to true
# In development with HTTP: set to false
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Demo account (used in frontend auto-fill button)
DEMO_USER_USERNAME=analyst-demo
DEMO_USER_PASSWORD=demo12345

# ============================================================================
# AI INTEGRATION
# ============================================================================
# Provider: 'claude' or 'gemini' (defaults to 'claude')
AI_PROVIDER=claude

# Claude API
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Gemini API (fallback / alternative)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# AI timeout (milliseconds)
AI_TIMEOUT_MS=30000

# Debug mode for AI calls
AI_DEBUG=false

# ============================================================================
# CORRELATION ENGINE (Bloco 2)
# ============================================================================
# Time window for grouping events (milliseconds)
CORRELATION_WINDOW_MS=60000

# Number of suspicious events to trigger an incident
CORRELATION_EVENT_THRESHOLD=3

# Severity threshold (0-100) for creating incidents
CORRELATION_SEVERITY_THRESHOLD=50

# Redis Streams consumer group name
CORRELATION_CONSUMER_GROUP=correlation-engine

# Consumer name (auto-generated if not set)
CORRELATION_CONSUMER_NAME=

# Block time when reading from stream (milliseconds)
CORRELATION_BLOCK_MS=5000

# Batch count per read cycle
CORRELATION_BATCH_COUNT=10

# ============================================================================
# APPLICATION PORTS
# ============================================================================
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_INCIDENT_DECISION_TIMEOUT_MS=120000

# ============================================================================
# LOGGING & DEBUG
# ============================================================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================================================
# RATE LIMITING
# ============================================================================
# Auth endpoint: max 5 requests per minute
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# ============================================================================
# DOCKER-SPECIFIC (only needed if not using .env file with docker-compose)
# ============================================================================
# These are typically sourced from the .env file by docker-compose,
# but can be overridden in docker-compose.yml if needed.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=section8half
